# Токен доступа к API Poster: Poster → Доступ → Интеграция (или OAuth-токен приложения)
POSTER_TOKEN=
# application_secret приложения в dev-кабинете Poster — для проверки подписи вебхуков
POSTER_APP_SECRET=
# true — отклонять вебхуки без верной подписи
POSTER_WEBHOOK_STRICT=false
# Деньги в API Poster приходят в копейках
POSTER_MONEY_DIVISOR=100

# Пароль админки и секрет для подписи (длинная случайная строка)
ADMIN_PASSWORD=
APP_SECRET=
DB_PASSWORD=

TZ_NAME=Europe/Moscow
PORT=3000

# Частота опроса Poster (мс): открытые чеки / полная сверка
POLL_OPEN_MS=4000
POLL_FULL_MS=60000
# Сколько секунд бармен может отменить свою отметку «готово»
UNDO_WINDOW_SEC=300
