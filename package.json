{
  "name": "poster-kds",
  "version": "1.0.0-beta.2",
  "description": "KDS для баров и ресторанов на Poster: станции, раздача, учёт кто приготовил",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/migrate.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "mock-poster": "node test/mock-poster.js",
    "simulate": "node scripts/simulate.js",
    "test:fast": "node --test --test-concurrency=1 test/normalize.test.js test/kds.test.js test/kitchen.test.js test/alerts.test.js test/http.test.js test/api.test.js",
    "test:e2e": "node --test test/e2e.test.js",
    "test:chaos": "./test/stack/chaos.sh",
    "doctor": "./scripts/doctor.sh",
    "pos:build": "node pos-app/build.mjs",
    "pos:upload": "node pos-app/upload.mjs",
    "pos:dev": "node pos-app/dev-server.mjs"
  },
  "license": "ISC",
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
