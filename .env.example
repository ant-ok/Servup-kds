# Публичный https-адрес установки (нужен для вебхуков и входа через Poster)
PUBLIC_URL=https://kds.example.com
# Домен для HTTPS. Пусто — локальный режим (HTTP в сети заведения). install.sh заполняет сам
DOMAIN=

# Секрет для подписи сессий и PIN (длинная случайная строка) и пароль панели /platform/
APP_SECRET=
PLATFORM_PASSWORD=
DB_PASSWORD=

# Приложение Poster (dev.joinposter.com): заведения подключаются сами по OAuth,
# application_secret также проверяет подпись вебхуков
POSTER_APP_ID=
POSTER_APP_SECRET=
POSTER_WEBHOOK_STRICT=false

# Режим одного заведения без приложения: токен из Poster → Доступ → Интеграция.
# При первом запуске создаётся заведение; вход в админку — POSTER_ACCOUNT + ADMIN_PASSWORD
POSTER_TOKEN=
POSTER_ACCOUNT=
ADMIN_PASSWORD=

# Деньги в API Poster приходят в копейках
POSTER_MONEY_DIVISOR=100
TZ_NAME=Europe/Moscow
PORT=3000

# Частота опроса Poster (мс): открытые чеки / полная сверка
POLL_OPEN_MS=4000
POLL_FULL_MS=60000
# Сколько секунд сотрудник может отменить свою отметку
UNDO_WINDOW_SEC=300

# Уведомления в Telegram: токен бота от @BotFather (один на всю установку)
# и чат владельца платформы, куда приходят тревоги всех заведений
TELEGRAM_BOT_TOKEN=
TELEGRAM_PLATFORM_CHAT_ID=
# Пороги тревог, минуты
ALERT_POSTER_DOWN_MIN=3
ALERT_SCREEN_OFFLINE_MIN=5
ALERT_STUCK_ORDER_MIN=30
